# Copy to /etc/portfolio-rag.env, replace every placeholder, then chmod 640.
SUPABASE_URL=https://<PROJECT-REF>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<REQUIRED-SB-SECRET-OR-LEGACY-SERVICE-ROLE-KEY>
CHAT_BACKEND_SECRET=<REQUIRED-32-BYTE-OR-LONGER-RANDOM-SECRET>

LLAMA_BASE_URL=http://127.0.0.1:8080
LLAMA_MODEL_ID=<PINNED-LLAMA-MODEL-ID>
LLAMA_MODEL_FILE=/opt/portfolio-rag/models/<EXACT-MODEL-FILENAME>.gguf
LLAMA_MODEL_SHA256=<PUBLISHER-VERIFIED-64-HEX-SHA256>
EMBEDDING_MODEL_ID=/opt/portfolio-rag/models/<PINNED-EMBEDDING-SNAPSHOT-DIRECTORY>
EMBEDDING_DIMENSION=768
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1
OMP_NUM_THREADS=2
TOKENIZERS_PARALLELISM=false

RAG_MATCH_THRESHOLD=0.31
RAG_MAX_CHUNKS=3
RAG_CANDIDATE_CHUNKS=12
RAG_MAX_CHUNKS_PER_DOCUMENT=2
RAG_MAX_CONTEXT_TOKENS=1500

CHAT_SEARCH_TIMEOUT_MS=15000
CHAT_FIRST_TOKEN_TIMEOUT_MS=90000
CHAT_TOTAL_TIMEOUT_MS=240000
CHAT_HEARTBEAT_SECONDS=8
CHAT_MAX_BODY_BYTES=16384
CHAT_TIMESTAMP_TOLERANCE_SECONDS=60
CHAT_REPLAY_TTL_SECONDS=300
CHAT_QUEUE_WAITERS=5
CHAT_MAX_OUTPUT_TOKENS=200
CHAT_TEMPERATURE=0.2
CHAT_TOP_P=0.9

WORKER_ID=<STABLE-ORACLE-WORKER-ID>
WORKER_POLL_SECONDS=2
WORKER_CLAIM_STALE_SECONDS=600
SENTRY_DSN=
LOG_LEVEL=INFO
